{
  "manifest_version": 3,
  "name": "plx Companion",
  "version": "0.3.0",
  "description": "Sync browser session credentials from Chrome, Edge, or Brave to plx CLI",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.spotify.com/*",
    "https://*.deezer.com/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "plx Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
