# Per-provider credential overrides. Each wins over whatever is saved in credentials.json.
# Both are optional — you only need the one(s) your chosen direction actually uses,
# and a --dry-run needs neither. Never commit the real values.

# Deezer ARL cookie — needed to write a Deezer playlist (F12 → Application → Cookies → arl)
DEEZER_ARL=

# Spotify sp_dc cookie — needed to write into a Spotify target, or to read your private
# playlists (F12 → Application → Cookies → sp_dc)
SPOTIFY_DC=
